# ── Frontend .dockerignore ──────────────────────────────────────────────
#
# Excluded from the build context. node_modules in particular is enormous
# and would otherwise be sent to the daemon on every build only to be
# overwritten by `npm ci`.

# Dependencies + build output
node_modules/
.next/
out/
dist/
coverage/

# Dev caches
.turbo/
.swc/
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp

# Git
.git/
.gitignore

# Env files (mounted via compose env_file or built into the runtime
# image deliberately, not baked from the host)
.env
.env.local
.env*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS junk
.DS_Store
Thumbs.db
