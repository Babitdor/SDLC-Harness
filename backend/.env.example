# Deep Agent Orchestrator — environment configuration
# Copy this to .env and fill in the values.

# ── Model (OpenAI-compatible / NHR FAU endpoint) ──────────────────────

# API key — may be empty if the endpoint doesn't require one
OPENAI_API_KEY=

# Model name (must be available on the endpoint)
AGENT_MODEL=mistralai/Mistral-Large-3.1-128B

# Name the orchestrator introduces itself with
# AGENT_IDENTITY=DevForge

# OpenAI-compatible endpoint (NHR FAU LLM Gateway by default)
OPENAI_BASE_URL=https://hub.nhr.fau.de/api/llmgw/v1

# Optional: Model temperature (default 0.7)
# OPENAI_TEMPERATURE=0.7

# ── Prompt caching ────────────────────────────────────────────────────
# ~96% of this pipeline's tokens are input tokens, and every model call
# re-sends the same prefix (orchestrator system prompt ~3.9k tokens + tool
# schemas). Providers cache that prefix on their own once it repeats; this
# setting only controls the routing hint that keeps one conversation on the
# same cache shard.
#   auto (default) — send prompt_cache_key to api.openai.com only, where the
#                    parameter is documented. Gateways are left alone.
#   on             — send it everywhere. Use when your gateway (e.g. LiteLLM)
#                    accepts and forwards it.
#   off            — never send it.
# Whether hits actually happen is the provider's business: watch
# GET /conversations/{id}/usage and the per-run "Run usage" log line, where
# cached_tokens and cache_hit_ratio are recorded.
# PROMPT_CACHE_KEY=auto

# ── Caveman: read less ────────────────────────────────────────────────
# Native port of the caveman "read less" idea (services/caveman.py, no
# sidecar and no account): tool *results* are compacted deterministically
# before they enter the model context — JSON reports, logs, diffs, tables,
# HTML and plain text each get their own compressor. Error/warning lines are
# always kept verbatim, the exact original is stored, and the model gets a
# caveman_retrieve tool to page it back.
#
#   read (default) — compact tool results above CAVEMAN_MIN_CHARS
#   off            — pass everything through unchanged (A/B the effect on
#                    artifact quality; the per-run "Caveman read-less totals"
#                    log line reports the char saving either way)
CAVEMAN_MODE=read
# Below this size nothing is compacted: the footer and a retrieve round-trip
# would cost more than the saving.
CAVEMAN_MIN_CHARS=2000

# ── Docker sandbox ────────────────────────────────────────────────────

DOCKER_IMAGE=python:3.12-slim
DOCKER_KEEP_ALIVE=true
# Sandbox network mode. "none" is the default and the only safe choice: the
# container needs no egress (model calls, validators and artifact tooling all
# run in the backend process). Anything else also exposes the harness API —
# published on 0.0.0.0:8000 — to agent-authored shell.
# DOCKER_NETWORK=none

# ── Sandbox isolation limits ──────────────────────────────────────────
# uid:gid every agent exec drops to (the container starts as root only to
# chown /workspace). Empty = image default, which is root.
DOCKER_SANDBOX_USER=1000:1000
# Hard ceilings so one chat cannot starve the host or the other chats.
DOCKER_SANDBOX_MEM_LIMIT=2g
DOCKER_SANDBOX_CPUS=2.0
DOCKER_SANDBOX_PIDS_LIMIT=512
# Stopped sandboxes older than this are removed at startup. 0 disables it.
DOCKER_ORPHAN_TTL_HOURS=24

# ── Server ────────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=8000

# ── Upload limits ─────────────────────────────────────────────────────

MAX_UPLOAD_SIZE_MB=50

# ── LangSmith tracing ─────────────────────────────────────────────────

# Set to "true" to enable LangSmith tracing.  This is the standard env var
# that LangChain/LangGraph check automatically — do NOT use LANGSMITH_TRACING.
LANGCHAIN_TRACING_V2=true

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sdlc-harness
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Postgres (conversations + messages) ───────────────────────────────
# Matches the shared postgres service in docker-compose.yml at the
# project root. Run `docker compose up -d` first.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/harness

# ── Performance tuning ─────────────────────────────────────────────────
# AnyIO thread pool (default 40 — bump for I/O-heavy Docker workloads)
THREAD_POOL_SIZE=100
# Docker SDK HTTP connection pool (default 10 — bump for concurrent execs)
DOCKER_POOL_SIZE=25
# Artifact list cache TTL in seconds (reduce Docker polling calls)
ARTIFACT_CACHE_TTL=1.0

# Browser-reachable backend callback; register this exact URI with MCP providers.
# Use HTTPS when the harness is hosted remotely.
MCP_OAUTH_CALLBACK_URL=http://localhost:8000/mcp/oauth/callback

# ── Auth (accounts + sessions) ────────────────────────────────────────
# Open signup: anyone who can reach the API can create an account, and a
# conversation is visible only to the account that created it.
# Name of the HttpOnly session cookie.
SESSION_COOKIE_NAME=sdlc_session
# How long a session stays valid without signing in again.
SESSION_TTL_DAYS=14
# 1 behind HTTPS. A Secure cookie is never sent over plain http, so this
# must stay 0 for a local http://localhost deploy or login silently fails.
SESSION_COOKIE_SECURE=0
# lax | strict | none. "lax" is enough for localhost:3000 -> localhost:8000
# (ports do not change the site). Cross-site needs none + SECURE=1.
SESSION_COOKIE_SAMESITE=lax
# Minimum password length. Length only, no composition rules.
MIN_PASSWORD_LENGTH=10
# Login throttle: failures allowed per window before 429 Retry-After.
# Per-process, so N gunicorn workers allow N times the attempts.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Comma-separated browser origins allowed to send credentials. Never "*":
# browsers refuse to attach a cookie to a wildcard origin.
CORS_ORIGINS=http://localhost:3000
